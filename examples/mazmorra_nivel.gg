// 1. Tamano de la sala: 16x16 casillas, cada casilla mide 2 metros
grid {
    size: (16, 16);
    cell_size: 2.0;
}

// 2. Muros perimetrales y trazado del pasillo
terrain {
    default: "piso_roca";

    // Levantar muros en los 4 bordes de la sala
    fill "muro_piedra" from (0, 0) to (15, 0);
    fill "muro_piedra" from (0, 15) to (15, 15);
    fill "muro_piedra" from (0, 0) to (0, 15);
    fill "muro_piedra" from (15, 0) to (15, 15);

    // Trazar un pasillo alfombrado directo hacia el centro
    path "alfombra_roja" from (8, 0) to (8, 8);
}

// 3. Puerta, cofre, antorchas y trampas
entities {
    limit "cofre_tesoro" <= 2;

    spawn "puerta_acceso" at (8, 0);
    spawn "cofre_tesoro" at center;

    distribute "antorcha" count 8 on perimeter;
    scatter "trampa_suelo" count 5;
}
